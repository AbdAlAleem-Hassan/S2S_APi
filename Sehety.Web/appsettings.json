{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://ops.seq:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "s2sservice"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JWTOptions": {
    "SecretKey": "",
    "Issuer": "https://localhost:7252",
    "Audience": "https://localhost:7252",
    "AccessTokenExpiryInMinutes": 15,
    "RefreshTokenExpiryInDays": 7
  },
  "AISettings": {
    "BaseUrl": "",
    "ApiKey": "",
    "HFToken": ""
  },
  "Groq": {
    "ApiKeys": []
  },
  "SttSettings": {
    "TimeoutSeconds": 30
  },
  "MediaCleanup": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "RetentionDays": 7
  },
  "UploadStorage": {
    "BasePath": "/app/wwwroot/media"
  },
  "TtsSettings": {
    "LanguageCode": "ar-XA",
    "VoiceName": "ar-XA-Wavenet-D"
  },
  "Google": {
    "ApplicationCredentials": "",
    "CredentialsJson": "",
    "Credentials": {}
  },
  "ResendSettings": {
    "ApiKey": ""
  },
  "AppUrls": {
    "ClientUrl": "https://s2sai.online",
    "ApiBaseUrl": "https://api.s2sai.online"
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Firebase": {
    "CredentialsPath": "firebase-adminsdk.json"
  },
  "QuotaLimits": {
    "Translation": {
      "Default": 10,
      "Free": 10,
      "Premium": -1
    }
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://s2sai.online",
      "https://www.s2sai.online",
      "http://localhost:3000",
      "http://localhost:5173",
      "https://localhost:7252",
      "http://localhost:5069"
    ]
  }
}
